{
  "name": "starwish-multiplayer",
  "private": true,
  "version": "0.8.2",
  "description": "星願物語 Stage 8.1 多人連線伺服器（ws＋PostgreSQL）與客戶端網路層；與單機版分開",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build:proto": "node build-proto.mjs",
    "start": "node server/main.ts",
    "start:lan": "HOST=0.0.0.0 node server/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "node --test tests/unit.test.ts",
    "test:combat": "node --test --test-concurrency=1 tests/combat.test.ts",
    "test:integration": "node --test --test-concurrency=1 tests/integration.test.ts",
    "test:browser": "node build-proto.mjs && node tests/browser-two-players.mjs",
    "test:wss": "bash tests/wss-check.sh",
    "test:db": "bash db/test-db.sh",
    "test:pg": "bash db/test-db.sh"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.50.0",
    "typescript": "^5.8.0"
  }
}
